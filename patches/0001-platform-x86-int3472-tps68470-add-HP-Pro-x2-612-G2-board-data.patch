From: TODO <TODO>
Subject: [PATCH] platform/x86: int3472: tps68470: Add board data for HP Pro x2 612 G2

The HP Pro x2 612 G2 is a Skylake tablet with an IPU3 and a TPS68470 PMIC
(ACPI \_SB.PCI0.CLP0, HID INT3472, _DDN "PMIC-CRDG", CLDB control-logic
type 2, TPS68470 REVID 0x21 at 0x48 on I2C2) powering the rear OV8858
sensor (\_SB.PCI0.LNK0, HID INT3477, I2C2 0x10, VCM at 0x0c with SSDB VCM
type 2 = dw9714, CSI-2 port 0, 4 lanes).

Without board data the PMIC fails to probe with:

  int3472-tps68470 i2c-INT3472:05: error -ENODEV: No board-data found for this model

and the sensor, which has an ACPI _DEP on the PMIC, never enumerates.

The BIOS provides no GPIO / power-rail hints (the C0GP/C0Px/C0Gx/C0Fx
fields are all 0). The PMIC follows the Intel CRD-G reference design, as
on the Surface Go, so use the same wiring: CORE 1.2 V for DVDD, ANA 2.8 V
for AVDD, VSIO 1.8 V for DOVDD (with VIO always-on at the same voltage),
VCM 2.8 V for the lens actuator, and TPS68470 GPIO 9 / 7 as the active-low
reset / powerdown lines.

The xvclk is provided by the clk-tps68470 cell, whose consumer names are
derived from the PMIC's ACPI dependents, so no board data is needed for it.

The sensor is reached through the TPS68470 I2C daisy chain: with GPIO1
driven as an output the host I2C bus reports arbitration loss, and the
sensor NACKs while the module EEPROM (0x50) answers. Enable the
daisy-chain property so that GPIO1/GPIO2 are kept as inputs, as is done
for the MSI Prestige AI Evo and Intel NVL boards.

Signed-off-by: TODO <TODO>
---
--- a/drivers/platform/x86/intel/int3472/tps68470_board_data.c
+++ b/drivers/platform/x86/intel/int3472/tps68470_board_data.c
@@ -369,6 +369,104 @@
 	},
 };
 
+/*
+ * Settings for HP Pro x2 612 G2 tablet (rear OV8858 camera, INT3477)
+ *
+ * The PMIC uses the Intel CRD-G reference design (_DDN "PMIC-CRDG") like the
+ * Surface Go and the BIOS provides no rail mapping (C0Px/C0Gx are all 0), so
+ * follow the Surface Go wiring of the CRD-G for the OV8858 rails:
+ *   CORE 1.2 V -> DVDD, ANA 2.8 V -> AVDD, VSIO 1.8 V -> DOVDD,
+ *   VCM 2.8 V -> VCM supply.
+ * VIO is kept always-on at the same voltage as VSIO; AUX1/AUX2 are left
+ * untouched as no second sensor hangs off this PMIC.
+ * The sensor is reached through the PMIC's I2C daisy chain: driving GPIO1
+ * as an output causes arbitration loss on the host I2C bus, and the sensor
+ * NACKs while the module EEPROM answers, so GPIO1/GPIO2 must stay inputs.
+ * The SSDB VCM type 2 is a dw9714, which requests its supply as "vcc"; "vdd"
+ * is provided as well for other VCM drivers.
+ */
+
+static struct regulator_consumer_supply int3477_core_consumer_supplies[] = {
+	REGULATOR_SUPPLY("dvdd", "i2c-INT3477:00"),
+};
+
+static struct regulator_consumer_supply int3477_ana_consumer_supplies[] = {
+	REGULATOR_SUPPLY("avdd", "i2c-INT3477:00"),
+};
+
+static struct regulator_consumer_supply int3477_vcm_consumer_supplies[] = {
+	REGULATOR_SUPPLY("vdd", "i2c-INT3477:00-VCM"),
+	REGULATOR_SUPPLY("vcc", "i2c-INT3477:00-VCM"),
+};
+
+static struct regulator_consumer_supply int3477_vsio_consumer_supplies[] = {
+	REGULATOR_SUPPLY("dovdd", "i2c-INT3477:00"),
+};
+
+static const struct regulator_init_data hp_x2_612_g2_tps68470_core_reg_init_data = {
+	.constraints = {
+		.min_uV = 1200000,
+		.max_uV = 1200000,
+		.apply_uV = true,
+		.valid_ops_mask = REGULATOR_CHANGE_STATUS,
+	},
+	.num_consumer_supplies = ARRAY_SIZE(int3477_core_consumer_supplies),
+	.consumer_supplies = int3477_core_consumer_supplies,
+};
+
+static const struct regulator_init_data hp_x2_612_g2_tps68470_ana_reg_init_data = {
+	.constraints = {
+		.min_uV = 2815200,
+		.max_uV = 2815200,
+		.apply_uV = true,
+		.valid_ops_mask = REGULATOR_CHANGE_STATUS,
+	},
+	.num_consumer_supplies = ARRAY_SIZE(int3477_ana_consumer_supplies),
+	.consumer_supplies = int3477_ana_consumer_supplies,
+};
+
+static const struct regulator_init_data hp_x2_612_g2_tps68470_vcm_reg_init_data = {
+	.constraints = {
+		.min_uV = 2815200,
+		.max_uV = 2815200,
+		.apply_uV = true,
+		.valid_ops_mask = REGULATOR_CHANGE_STATUS,
+	},
+	.num_consumer_supplies = ARRAY_SIZE(int3477_vcm_consumer_supplies),
+	.consumer_supplies = int3477_vcm_consumer_supplies,
+};
+
+/* Ensure the always-on VIO regulator has the same voltage as VSIO */
+static const struct regulator_init_data hp_x2_612_g2_tps68470_vio_reg_init_data = {
+	.constraints = {
+		.min_uV = 1800600,
+		.max_uV = 1800600,
+		.apply_uV = true,
+		.always_on = true,
+	},
+};
+
+static const struct regulator_init_data hp_x2_612_g2_tps68470_vsio_reg_init_data = {
+	.constraints = {
+		.min_uV = 1800600,
+		.max_uV = 1800600,
+		.apply_uV = true,
+		.valid_ops_mask = REGULATOR_CHANGE_STATUS,
+	},
+	.num_consumer_supplies = ARRAY_SIZE(int3477_vsio_consumer_supplies),
+	.consumer_supplies = int3477_vsio_consumer_supplies,
+};
+
+static const struct tps68470_regulator_platform_data hp_x2_612_g2_tps68470_pdata = {
+	.reg_init_data = {
+		[TPS68470_CORE] = &hp_x2_612_g2_tps68470_core_reg_init_data,
+		[TPS68470_ANA]  = &hp_x2_612_g2_tps68470_ana_reg_init_data,
+		[TPS68470_VCM]  = &hp_x2_612_g2_tps68470_vcm_reg_init_data,
+		[TPS68470_VIO]  = &hp_x2_612_g2_tps68470_vio_reg_init_data,
+		[TPS68470_VSIO] = &hp_x2_612_g2_tps68470_vsio_reg_init_data,
+	},
+};
+
 static struct gpiod_lookup_table surface_go_int347a_gpios = {
 	.dev_id = "i2c-INT347A:00",
 	.table = {
@@ -411,6 +509,15 @@
 	}
 };
 
+static struct gpiod_lookup_table hp_x2_612_g2_int3477_gpios = {
+	.dev_id = "i2c-INT3477:00",
+	.table = {
+		GPIO_LOOKUP("tps68470-gpio", 9, "reset", GPIO_ACTIVE_LOW),
+		GPIO_LOOKUP("tps68470-gpio", 7, "powerdown", GPIO_ACTIVE_LOW),
+		{ }
+	}
+};
+
 static const struct property_entry int3472_tps68470_daisy_chain_gpio_props[] = {
 	PROPERTY_ENTRY_BOOL("daisy-chain-enable"),
 	{ }
@@ -469,6 +576,16 @@
 	},
 };
 
+static const struct int3472_tps68470_board_data hp_x2_612_g2_tps68470_board_data = {
+	.dev_name = "i2c-INT3472:05",
+	.tps68470_regulator_pdata = &hp_x2_612_g2_tps68470_pdata,
+	.tps68470_gpio_swnode = &int3472_tps68470_daisy_chain_gpio_swnode,
+	.n_gpiod_lookups = 1,
+	.tps68470_gpio_lookup_tables = {
+		&hp_x2_612_g2_int3477_gpios,
+	},
+};
+
 static const struct dmi_system_id int3472_tps68470_board_data_table[] = {
 	{
 		.matches = {
@@ -529,6 +646,13 @@
 		},
 		.driver_data = (void *)&intel_nvl_tps68470_board_data,
 	},
+	{
+		.matches = {
+			DMI_EXACT_MATCH(DMI_SYS_VENDOR, "HP"),
+			DMI_EXACT_MATCH(DMI_PRODUCT_NAME, "HP Pro x2 612 G2"),
+		},
+		.driver_data = (void *)&hp_x2_612_g2_tps68470_board_data,
+	},
 	{ }
 };
 
