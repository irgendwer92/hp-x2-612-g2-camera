# libcamera with the HP Pro x2 612 G2 patches (IPU3 lens shading, OV8858 and
# IMX241 support and tuning, sensor digital gain), built on top of Arch's
# libcamera packaging. Only the packages a desktop needs are built: libcamera,
# libcamera-ipa and libcamera-tools (no docs, GStreamer or Python bindings).
#
# pkgver/pkgrel follow Arch's current libcamera; run ./update.sh to sync them
# and rebuild. Patches come from ../../libcamera/patches/ in this repository.

pkgbase=libcamera
pkgname=(
  libcamera
  libcamera-ipa
  libcamera-tools
)
pkgver=0.7.2
_archrel=4
pkgrel=$_archrel.1
pkgdesc="A complex camera support library for Linux, Android, and ChromeOS (HP Pro x2 612 G2 patches)"
arch=(x86_64)
url="https://libcamera.org/"
_url=https://git.libcamera.org/libcamera/libcamera.git
makedepends=(
  git
  glib2
  libdrm
  libevent
  libgcc
  libjpeg-turbo
  libstdc++
  libtiff
  libyaml
  libyuv
  meson
  python-jinja
  python-ply
  python-pyyaml
  qt6-base
  sdl2
  systemd
)
source=("git+$_url#tag=v$pkgver")
sha512sums=('SKIP')

_patchdir="$startdir/../../libcamera/patches"
# Rear camera lens shading calibration from tools/lsc (optional, per device)
_lsc_tuning="$startdir/../../lsc-out/ov8858.yaml"

_pick() {
  local p="$1" f d; shift
  for f; do
    [[ -e $f ]] || continue
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

prepare() {
  cd $pkgbase

  local p
  for p in "$_patchdir"/*.patch; do
    echo "applying $(basename "$p")"
    if ! git apply --index "$p"; then
      error "$(basename "$p") does not apply to libcamera $pkgver; rebase the series in ~/Projects/libcamera"
      return 1
    fi
  done

  # add version, so that utils/gen-version.sh may rely on it
  printf "%s\n" "$pkgver" > .tarball-version
}

build() {
  local meson_options=(
    -D v4l2=enabled
    -D tracing=disabled
    -D test=false
    -D lc-compliance=disabled
    -D documentation=disabled
    -D gstreamer=disabled
    -D pycamera=disabled
    -D cam=enabled
    -D qcam=enabled
  )

  arch-meson $pkgbase build "${meson_options[@]}"
  meson compile -C build
}

package_libcamera() {
  license=(
    Apache-2.0
    CC0-1.0
    'GPL-2.0-only WITH Linux-syscall-note'
    GPL-2.0-or-later
    LGPL-2.1-or-later
    'GPL-2.0-or-later WITH Linux-syscall-note OR BSD-3-Clause'
    'GPL-2.0-or-later WITH Linux-syscall-note OR MIT'
  )
  depends=(
    glibc
    gnutls
    libcamera-ipa
    libelf
    libgcc
    libglvnd
    libstdc++
    libunwind
    libyaml
    libyuv
    sh
    systemd-libs libudev.so
  )
  optdepends=('libcamera-tools: for applications')
  provides=(libcamera.so libcamera-base.so)

  meson install -C build --destdir "$pkgdir"
  install -vDm 644 $pkgbase/LICENSES/{BSD-3-Clause,Linux-syscall-note,MIT}.txt -t "$pkgdir/usr/share/licenses/$pkgname/"

  # Ship this device's calibrated OV8858 tables in place of the identity
  # ones. It lives in the package (not /etc) so that a stock libcamera,
  # which has no Lsc algorithm, never sees it.
  if [[ -f $_lsc_tuning ]]; then
    install -vDm 644 "$_lsc_tuning" "$pkgdir/usr/share/libcamera/ipa/ipu3/ov8858.yaml"
  else
    warning "no $_lsc_tuning: shipping the uncalibrated (identity) OV8858 lens shading"
  fi

  (
    cd "$pkgdir"
    _pick $pkgbase-ipa usr/lib/libcamera/
    _pick $pkgbase-tools usr/bin/{cam,libcamera-bug-report,lc-compliance,qcam}
  )
}

package_libcamera-ipa() {
  pkgdesc+=" - signed IPA"
  license=(
    BSD-2-Clause
    CC-BY-SA-4.0
    CC0-1.0
    GPL-2.0-or-later
    LGPL-2.1-or-later
  )
  depends=(
    glibc
    libcamera libcamera.so libcamera-base.so
    libgcc
    libstdc++
  )
  # stripping requires re-signing of IPA libs, so we do it manually
  options=(!strip)

  strip $pkgname/usr/lib/libcamera/*{.so,proxy}
  for _lib in $pkgname/usr/lib/libcamera/*.so; do
    $pkgbase/src/ipa/ipa-sign.sh "$(find build -type f -iname "*ipa-priv-key.pem")" "$_lib" "$_lib.sign"
  done
  mv -v $pkgname/* "$pkgdir"
  install -vDm 644 $pkgbase/LICENSES/BSD-2-Clause.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}

package_libcamera-tools() {
  pkgdesc+=" - tools"
  license=(
    BSD-2-Clause
    CC0-1.0
    GPL-2.0-or-later
    LGPL-2.1-or-later
  )
  depends=(
    glibc
    libcamera libcamera.so libcamera-base.so
    libdrm
    libevent libevent-2.1.so libevent_pthreads-2.1.so
    libgcc
    libjpeg-turbo libjpeg.so
    libstdc++
    libtiff libtiff.so
    libyaml
    qt6-base
    sdl2
  )

  mv -v $pkgname/* "$pkgdir"
  install -vDm 644 $pkgbase/LICENSES/BSD-2-Clause.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}
