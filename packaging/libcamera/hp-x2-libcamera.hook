# pacman hook: print a reminder when an Arch update replaces the patched
# libcamera (HP Pro x2 612 G2) with a stock build. It only prints; it never
# blocks or changes the transaction. Install from the repository root with
#   sudo install -Dm644 packaging/libcamera/hp-x2-libcamera.hook /etc/pacman.d/hooks/hp-x2-libcamera.hook
# and remove it with  sudo rm /etc/pacman.d/hooks/hp-x2-libcamera.hook
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = libcamera

[Action]
Description = Checking for the HP Pro x2 612 G2 libcamera patches...
When = PostTransaction
Exec = /usr/bin/sh -c 'pacman -Qi libcamera | grep -q "HP Pro x2 612 G2 patches" || echo "==> libcamera is now a stock build: the front camera and the image improvements are gone. Rebuild with packaging/libcamera/update.sh in the hp-x2-612-g2-camera repository."'
