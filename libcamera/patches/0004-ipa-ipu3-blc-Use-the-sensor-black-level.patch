From f1b38ff041a15cae864913c5251c66f07020189b Mon Sep 17 00:00:00 2001
From: Richard Fritz <gh@chaos4all.de>
Date: Wed, 14 Oct 2026 22:37:09 +0200
Subject: [PATCH 4/8] ipa: ipu3: blc: Use the sensor black level

The IPU3 black level correction subtracts a hard-coded 64 on every
sensor. On sensors with a lower pedestal this over-subtracts, crushing
shadows, and it biases lens shading correction where the signal is
low: on an OV8858 (black level 16) the corners stay visibly dark and
cyan after correction.

Take the black level from the camera sensor helper, converted from the
helper's 16-bit scale to the 10-bit ImgU input, and keep 64 as the
default when the helper doesn't provide one.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Richard Fritz <gh@chaos4all.de>
---
 src/ipa/ipu3/algorithms/blc.cpp | 22 +++++++++++-----------
 src/ipa/ipu3/ipa_context.cpp    |  8 ++++++++
 src/ipa/ipu3/ipa_context.h      |  4 ++++
 src/ipa/ipu3/ipu3.cpp           |  8 ++++++++
 4 files changed, 31 insertions(+), 11 deletions(-)

diff --git a/src/ipa/ipu3/algorithms/blc.cpp b/src/ipa/ipu3/algorithms/blc.cpp
index 35748fb2c..4af021946 100644
--- a/src/ipa/ipu3/algorithms/blc.cpp
+++ b/src/ipa/ipu3/algorithms/blc.cpp
@@ -27,7 +27,9 @@ namespace ipa::ipu3::algorithms {
  *
  * The black level can be measured at runtime from an optical dark region of the
  * camera sensor, or measured during the camera tuning process. The first option
- * isn't currently supported.
+ * isn't currently supported. The black level reported by the camera sensor
+ * helper is used, or a default of 64 at 10 bits if the helper doesn't provide
+ * one.
  */
 
 BlackLevelCorrection::BlackLevelCorrection()
@@ -44,20 +46,18 @@ BlackLevelCorrection::BlackLevelCorrection()
  * Populate the IPU3 parameter structure with the correction values for each
  * channel and enable the corresponding ImgU block processing.
  */
-void BlackLevelCorrection::prepare([[maybe_unused]] IPAContext &context,
+void BlackLevelCorrection::prepare(IPAContext &context,
 				   [[maybe_unused]] const uint32_t frame,
 				   [[maybe_unused]] IPAFrameContext &frameContext,
 				   ipu3_uapi_params *params)
 {
-	/*
-	 * The Optical Black Level correction values
-	 * \todo The correction values should come from sensor specific
-	 * tuning processes. This is a first rough approximation.
-	 */
-	params->obgrid_param.gr = 64;
-	params->obgrid_param.r = 64;
-	params->obgrid_param.b = 64;
-	params->obgrid_param.gb = 64;
+	/* The Optical Black Level correction values */
+	const uint16_t level = context.configuration.blc.level;
+
+	params->obgrid_param.gr = level;
+	params->obgrid_param.r = level;
+	params->obgrid_param.b = level;
+	params->obgrid_param.gb = level;
 
 	/* Enable the custom black level correction processing */
 	params->use.obgrid = 1;
diff --git a/src/ipa/ipu3/ipa_context.cpp b/src/ipa/ipu3/ipa_context.cpp
index dc5b34497..2d1dc89d2 100644
--- a/src/ipa/ipu3/ipa_context.cpp
+++ b/src/ipa/ipu3/ipa_context.cpp
@@ -123,6 +123,14 @@ namespace libcamera::ipa::ipu3 {
  * \brief Sensor output resolution
  */
 
+/**
+ * \var IPASessionConfiguration::blc
+ * \brief Black level correction configuration of the IPA
+ *
+ * \var IPASessionConfiguration::blc.level
+ * \brief Black level of the sensor, in 10-bit units of the ImgU input
+ */
+
 /**
  * \var IPAActiveState::agc
  * \brief Context for the Automatic Gain Control algorithm
diff --git a/src/ipa/ipu3/ipa_context.h b/src/ipa/ipu3/ipa_context.h
index ae2a09895..b367436e6 100644
--- a/src/ipa/ipu3/ipa_context.h
+++ b/src/ipa/ipu3/ipa_context.h
@@ -44,6 +44,10 @@ struct IPASessionConfiguration {
 		utils::Duration lineDuration;
 		Size size;
 	} sensor;
+
+	struct {
+		uint16_t level;
+	} blc;
 };
 
 struct IPAActiveState {
diff --git a/src/ipa/ipu3/ipu3.cpp b/src/ipa/ipu3/ipu3.cpp
index 4bdc4b767..9894e09d8 100644
--- a/src/ipa/ipu3/ipu3.cpp
+++ b/src/ipa/ipu3/ipu3.cpp
@@ -225,6 +225,14 @@ void IPAIPU3::updateSessionConfiguration(const ControlInfoMap &sensorControls)
 	context_.configuration.agc.maxExposureTime = maxExposure * context_.configuration.sensor.lineDuration;
 	context_.configuration.agc.minAnalogueGain = camHelper_->gain(minGain);
 	context_.configuration.agc.maxAnalogueGain = camHelper_->gain(maxGain);
+
+	/*
+	 * The sensor helper expresses the black level on a 16-bit scale, the
+	 * ImgU black level correction works on the 10-bit CIO2 output. Keep
+	 * the historical default of 64 for sensors without a known level.
+	 */
+	context_.configuration.blc.level =
+		camHelper_->blackLevel().value_or(4096) >> 6;
 }
 
 /**
