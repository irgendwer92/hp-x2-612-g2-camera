From 338dd0201a1eb6d1623df8ccd13634c0f5ca377f Mon Sep 17 00:00:00 2001
From: Richard Fritz <gh@chaos4all.de>
Date: Wed, 14 Oct 2026 22:37:09 +0200
Subject: [PATCH 2/8] ipa: ipu3: Add OV8858 tuning file

Add a tuning file for the OmniVision OV8858, based on the uncalibrated
tuning file with an additional Lsc entry. Lens shading depends on the
camera module, so the shading tables contain unity gains as a
placeholder for module-specific calibration data. With these tables the
image is the same as without lens shading correction.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Richard Fritz <gh@chaos4all.de>
---
 src/ipa/ipu3/data/meson.build |   1 +
 src/ipa/ipu3/data/ov8858.yaml | 124 ++++++++++++++++++++++++++++++++++
 2 files changed, 125 insertions(+)
 create mode 100644 src/ipa/ipu3/data/ov8858.yaml

diff --git a/src/ipa/ipu3/data/meson.build b/src/ipa/ipu3/data/meson.build
index 0f7cd5c64..c456a7f08 100644
--- a/src/ipa/ipu3/data/meson.build
+++ b/src/ipa/ipu3/data/meson.build
@@ -1,6 +1,7 @@
 # SPDX-License-Identifier: CC0-1.0
 
 conf_files = files([
+    'ov8858.yaml',
     'uncalibrated.yaml',
 ])
 
