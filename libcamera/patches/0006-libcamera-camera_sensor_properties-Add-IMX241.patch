From cf3f53eaaf1e97e8792e8a7a95c94c7244cdffb1 Mon Sep 17 00:00:00 2001
From: Richard Fritz <gh@chaos4all.de>
Date: Wed, 14 Oct 2026 22:37:09 +0200
Subject: [PATCH 6/8] libcamera: camera_sensor_properties: Add IMX241

Add static properties for the Sony IMX241, a 2592x1944 sensor. No Sony
datasheet is publicly available. The 1.12 um unit cell size is taken
from a distributor's product listing (FRAMOS) and hasn't been verified
otherwise.

The test pattern menu of the imx241 kernel driver (not upstream yet)
follows the SMIA test_pattern_mode register (0x0600): solid colour,
colour bars, fade to grey colour bars and PN9. The sensor delays are not
known yet, so the defaults apply.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Richard Fritz <gh@chaos4all.de>
---
 src/libcamera/sensor/camera_sensor_properties.cpp | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/src/libcamera/sensor/camera_sensor_properties.cpp b/src/libcamera/sensor/camera_sensor_properties.cpp
index 28043150e..3604069c1 100644
--- a/src/libcamera/sensor/camera_sensor_properties.cpp
+++ b/src/libcamera/sensor/camera_sensor_properties.cpp
@@ -210,6 +210,17 @@ const CameraSensorProperties *CameraSensorProperties::get(const std::string &sen
 				.hblankDelay = 2
 			},
 		} },
+		{ "imx241", {
+			.unitCellSize = { 1120, 1120 },
+			.testPatternModes = {
+				{ controls::draft::TestPatternModeOff, 0 },
+				{ controls::draft::TestPatternModeSolidColor, 1 },
+				{ controls::draft::TestPatternModeColorBars, 2 },
+				{ controls::draft::TestPatternModeColorBarsFadeToGray, 3 },
+				{ controls::draft::TestPatternModePn9, 4 },
+			},
+			.sensorDelays = { },
+		} },
 		{ "imx258", {
 			.unitCellSize = { 1120, 1120 },
 			.testPatternModes = {
