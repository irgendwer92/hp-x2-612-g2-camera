+				     const std::vector<double> &xPos,
+				     const std::vector<double> &yPos) const;
+	void fillLut(const Components &gains);
+
+	/* Tuning data, sampled on the sensor pixel array. */
+	Size tuningGrid_;
+	std::map<unsigned int, Components> tuningSets_;
+
+	/* Tuning data resampled on the ImgU shading grid. */
+	ipa::Interpolator<Components> sets_;
+
+	ipu3_uapi_shd_config_static config_;
+	ipu3_uapi_shd_lut lut_;
+
+	unsigned int lastAppliedCt_;
+	unsigned int lastAppliedQuantizedCt_;
+	bool lutValid_;
+};
